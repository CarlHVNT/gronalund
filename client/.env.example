# Leave unset in local dev (Vite proxies /api to http://localhost:4000, see vite.config.js)
# and on Netlify (the API runs as a Netlify Function on the same origin).
# Only set this when the API runs on a separate host, e.g. Render:
# VITE_API_URL=https://gronalund-server.onrender.com
VITE_API_URL=
